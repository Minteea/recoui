{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "plugins": [
    "@typescript-eslint",
    "no-only-tests",
    "eslint-comments"
  ],
  "ignorePatterns": [
    "**/node_modules",
    "**/dist",
    "**/storybook-static"
  ],
  "parserOptions": {
    "project": [
      "./packages/*/tsconfig.json"
    ],
    "sourceType": "module"
  },
  "rules": {
    "prefer-const": "warn",
    "no-console": "warn",
    "no-debugger": "warn",
    "@typescript-eslint/no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_"
      }
    ],
    "@typescript-eslint/no-unnecessary-type-assertion": "warn",
    "no-only-tests/no-only-tests": "warn",
    "eslint-comments/no-unused-disable": "warn"
  }
}
