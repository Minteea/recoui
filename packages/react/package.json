{
  "name": "@recoui/react",
  "private": true,
  "version": "0.0.0",
  "description": "React components built on Reco UI styles",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "storybook": "storybook dev -p 36008",
    "build-storybook": "storybook build",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@recoui/style": "workspace:*",
    "clsx": "2.1.1"
  },
  "peerDependencies": {
    "react": ">=18 <20"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.4.2",
    "@storybook/addon-docs": "10.4.2",
    "@storybook/react-vite": "10.4.2",
    "@types/node": "^22.12.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "^24.0.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sass": "1.100.0",
    "storybook": "10.4.2",
    "tsup": "^8.0.2",
    "typescript": "^5.7.2",
    "vite": "^7.1.4",
    "vitest": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
