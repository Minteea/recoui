{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "~": ["./src"],
      "~/*": ["./src/*"]
    },
    "jsx": "react-jsx",
    "types": ["vite/client", "node"]
  },
  "include": [
    "src",
    "stories",
    ".storybook",
    "test",
    "tsup.config.ts",
    "vitest.config.ts",
    "vite.config.ts"
  ],
  "exclude": ["node_modules", "dist", "storybook-static"]
}
